# Copy this file to .env and add credentials only on your own machine.
# Never commit .env or paste real keys into source code.

APP_NAME=CollegeAssistant
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Language model: gigachat or ollama
LLM_PROVIDER=gigachat
LLM_FALLBACK_PROVIDER=gigachat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-Max
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Speech recognition: vosk or whisper
STT_PROVIDER=vosk
VOSK_MODEL_PATH=data/vosk_model/vosk-model-ru-0.42
WHISPER_MODEL_SIZE=base

# Speech synthesis: gemini or yandex
TTS_PROVIDER=gemini
TTS_FALLBACK_PROVIDER=yandex
GEMINI_API_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Local data paths
KNOWLEDGE_DIR=data/knowledge
BUILDING_GRAPH_PATH=data/maps/building_graph.json
CHROMA_PERSIST_DIR=data/chroma_db
DATABASE_URL=sqlite+aiosqlite:///data/assistant.db
